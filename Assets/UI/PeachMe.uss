/* PeachMe HUD. Sizes are logical pixels against a 1080x1920 portrait reference
   (PanelSettings: scale with screen size), so they read the same on every phone. */

.pm-safe {
    position: absolute;
    flex-direction: column;
    justify-content: space-between;
}

.pm-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px 0 32px;
}

.pm-col {
    flex-direction: column;
}

.pm-state {
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.pm-small {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.pm-score {
    font-size: 64px;
    color: rgb(255, 230, 90);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.pm-gap-track {
    margin: 16px 32px 0 32px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 14px;
    overflow: hidden;
}

.pm-gap-fill {
    height: 100%;
    background-color: rgb(110, 210, 120);
    border-radius: 14px;
}

.pm-gap-fill--danger {
    background-color: rgb(255, 120, 80);
}

.pm-banner {
    font-size: 96px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 48px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.pm-hint {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 48px 64px 48px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.pm-special {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    padding: 0 0 24px 0;
}

.pm-special--ready {
    color: rgb(120, 230, 255);
    -unity-font-style: bold;
}
